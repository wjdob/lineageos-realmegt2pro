diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 22a3390..df306f2 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -214,3 +214,45 @@ WPA_SUPPLICANT_VERSION := VER_0_8_X
 
 # Include the proprietary files BoardConfig.
 include vendor/oneplus/sm8450-common/BoardConfigVendor.mk
+
+# Added 2026-10-11 for the realmeGT2Pro recovery build.
+# The LineageOS sepolicy configuration is not included by this device tree.
+#
+#   common/sepolicy.mk adds device/lineage/sepolicy/common/{public,private,dynamic,vendor}
+#     to the sepolicy search path. Without it, attributes declared there, such as
+#     hal_lineage_livedisplay_server, are undeclared and checkpolicy fails with
+#     'attribute hal_lineage_livedisplay_server is not declared'.
+#
+#   qcom/sepolicy.mk adds the qcom policy dirs and sets BOARD_SEPOLICY_M4DEFS mappings
+#     that rename generic sysfs types to their vendor_ prefixed forms. Without it,
+#     sysfs_battery_supply and sysfs_usb_supply are unresolved even though the trees
+#     define the vendor_ prefixed types.
+#
+# These come first because they are plain variable appends.
+include device/lineage/sepolicy/common/sepolicy.mk
+include device/lineage/sepolicy/qcom/sepolicy.mk
+
+
+# Added 2026-10-09 for the realmeGT2Pro recovery build.
+# hardware/qcom-caf/wlan/Android.bp declares an empty soong_namespace, so the module
+# libwifi-hal-qcom is unreachable by bare name unless its namespace is listed. The
+# device sets BOARD_WLAN_DEVICE := qcwcn, which makes
+# frameworks/opt/net/wifi/libwifi_hal/Android.bp reference it by bare name.
+PRODUCT_SOONG_NAMESPACES += \
+    hardware/qcom-caf/wlan \
+    hardware/qcom-caf/wlan/qcwcn
+
+
+# Added 2026-10-09 for the realmeGT2Pro recovery build.
+# vendor/lineage/config/BoardConfigLineage.mk is the only file that includes
+# BoardConfigKernel.mk and BoardConfigSoong.mk. Without it the LineageOS Soong
+# variables are never exported and the lineage_generator modules fail with
+# 'cmd: unknown variable $(KERNEL_BUILD_OUT_PREFIX)'.
+#
+# THIS MUST BE THE LAST LINE OF THIS FILE. BoardConfigLineage.mk includes
+# hardware/qcom-caf/common/BoardConfigQcom.mk, but only when
+# BOARD_USES_QCOM_HARDWARE is already true. That flag is set mid-file. Make
+# evaluates sequentially, so placing this include earlier silently skips
+# BoardConfigQcom.mk and none of the Qualcomm CAF soong namespaces are added,
+# producing about 27 unreachable modules.
+include vendor/lineage/config/BoardConfigLineage.mk
